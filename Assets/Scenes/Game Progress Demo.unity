MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1118860587}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a213d9817b22f488a8880b4ca3e4eb47, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Orange
        icon: {fileID: 4130640169021434097, guid: f380f82a31f09403bbcd1346a94b2e6c, type: 3}
      line: Red, I can't believe it's you. You found me! I got so scared during the
        storm and ran to look for cover.
    - character:
        name: Orange
        icon: {fileID: 4130640169021434097, guid: f380f82a31f09403bbcd1346a94b2e6c, type: 3}
      line: I have no idea where the others went. We have to go find them!
    - character:
        name: Red
        icon: {fileID: 6937817954938267909, guid: 9cd73eb4cda55426dbea2b839d851644, type: 3}
      line: I'm so glad you're safe, Orange! Yes, let's go look for the others.
